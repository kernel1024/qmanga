<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.kernel1024.jpreader.auxtranslator">
    <signal name="gotTranslation">
      <arg name="text" type="s" direction="out"/>
    </signal>
    <method name="setText">
      <arg name="text" type="s" direction="in"/>
    </method>
    <method name="setSrcLang">
      <arg name="lang" type="s" direction="in"/>
    </method>
    <method name="setDestLang">
      <arg name="lang" type="s" direction="in"/>
    </method>
    <method name="translateAndQuit">
    </method>
    <method name="startAuxTranslation">
      <arg name="text" type="s" direction="in"/>
    </method>
    <method name="startTranslationRequest">
        <arg name="requestId" type="t" direction="in"/>
        <arg name="text" type="s" direction="in"/>
        <arg name="sourceLang" type="s" direction="in"/>
        <arg name="targetLang" type="s" direction="in"/>
    </method>
    <signal name="translationRequestFinished">
        <arg name="requestId" type="t" direction="out"/>
        <arg name="text" type="s" direction="out"/>
    </signal>
  </interface>
</node>
